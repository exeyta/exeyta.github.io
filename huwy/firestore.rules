rules_version = '2';
// Huwy Wallet — Firestore rules. Вставить в Firebase Console → Firestore Database → Rules.
// ADMIN_UID ниже заменить на UID аккаунта админа (Authentication → Users → UID).
// Пока стоит заглушка — права админа никому не выданы.
service cloud.firestore {
  match /databases/{database}/documents {

    function adminUid() { return 'ADMIN_UID_PLACEHOLDER'; }
    function isAdmin() { return request.auth != null && adminUid() != 'ADMIN_UID_PLACEHOLDER' && request.auth.uid == adminUid(); }
    function isUser(uid) { return request.auth != null && request.auth.uid == uid; }
    function addrOk(a) { return a is string && a.matches('^HUWY-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{8}$'); }
    function loginOk(l) { return l is string && l.matches('^[a-z0-9_а-яё-]{3,24}$'); }

    // ---------- кошельки ----------
    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid)
        && loginOk(request.resource.data.login)
        && addrOk(request.resource.data.address)
        && request.resource.data.balance == 100
        && request.resource.data.pendingClaim == ''
        && request.resource.data.createdAt == request.time();
      allow update: if isAdmin()
        || (isUser(uid) && selfUpdateOk(uid));
    }

    // Свои деньги можно только ТРАТИТЬ (уменьшать). Увеличить баланс можно
    // только один раз по каждому переводу/ставке через свежий pendingClaim.
    function selfUpdateOk(uid) {
      let nd = request.resource.data;
      let od = resource.data;
      return nd.login == od.login && nd.address == od.address && nd.createdAt == od.createdAt
        && nd.balance is number && nd.balance >= 0 && nd.balance <= 1000000000
        && nd.pendingClaim is string
        && (
          (nd.balance == od.balance && nd.pendingClaim == od.pendingClaim)
          || (nd.balance < od.balance && nd.pendingClaim == od.pendingClaim)
          || (nd.balance > od.balance && nd.balance - od.balance <= 1000000
              && nd.pendingClaim != od.pendingClaim
              && (transferClaim(uid, nd, od) || betClaim(uid, nd, od)))
        );
    }

    function transferClaim(uid, nd, od) {
      let t = get(/databases/$(database)/documents/transfers/$(nd.pendingClaim)).data;
      return t.toUid == uid && t.claimed == false && t.amount == (nd.balance - od.balance);
    }

    function betClaim(uid, nd, od) {
      let b = get(/databases/$(database)/documents/bets/$(nd.pendingClaim)).data;
      return b.uid == uid && b.claimed == false && b.amount * 2 == (nd.balance - od.balance);
    }

    // ---------- переводы (эскроу: отправитель списывает, получатель забирает) ----------
    match /transfers/{tid} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.claimed == false
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 120
        && request.resource.data.t == request.time()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance >= request.resource.data.amount
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid));
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
      allow delete: if false;
    }

    // ---------- ставки (исход решает клиент — честно только для игры) ----------
    match /bets/{bid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount >= 1 && request.resource.data.amount <= 1000000
        && request.resource.data.claimed == false
        && request.resource.data.t == request.time()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance >= request.resource.data.amount;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
      allow delete: if false;
    }

    // ---------- история (только чтение своих записей, создание — свои/админ) ----------
    match /ledger/{uid}/items/{iid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if (isUser(uid) && request.resource.data.uid == uid) || isAdmin();
      allow update, delete: if false;
    }

    // ---------- справочники (нужны для поиска получателя и уникальности) ----------
    match /logins/{login} {
      allow read: if true;
      allow create: if request.auth != null && loginOk(login)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /addresses/{addr} {
      allow read: if true;
      allow create: if request.auth != null && addrOk(addr)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.login is string;
      allow update, delete: if false;
    }
  }
}
